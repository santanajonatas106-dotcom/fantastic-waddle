  <div class="grid3">
    <article><b>1</b><h3>Preencha seus dados</h3><p>Informe experiências, formação e habilidades.</p></article>
    <article><b>2</b><h3>Melhore com IA</h3><p>Receba um resumo profissional mais claro e objetivo.</p></article>
    <article><b>3</b><h3>Baixe em PDF</h3><p>Confira o resultado e gere seu documento profissional.</p></article>
  </div>
</section>
<%- include('partials/footer') %>
